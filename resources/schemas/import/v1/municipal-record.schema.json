{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://nipkaart.nl/schemas/import/1.0/municipal-record.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "external_id",
        "source_updated_at",
        "position",
        "geometry_method",
        "country_code",
        "administrative_codes",
        "name",
        "street",
        "accessible_capacity",
        "access_category",
        "orientation",
        "restrictions",
        "unmapped_fields",
        "source_record_url"
    ],
    "properties": {
        "external_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\s]+$"
        },
        "source_updated_at": {
            "anyOf": [
                {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$"
                },
                {
                    "type": "null"
                }
            ]
        },
        "position": {
            "type": "object",
            "additionalProperties": false,
            "required": ["latitude", "longitude"],
            "properties": {
                "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                },
                "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                }
            }
        },
        "geometry_method": {
            "enum": ["source_point", "derived_point"]
        },
        "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
        },
        "administrative_codes": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scheme", "code"],
                "properties": {
                    "scheme": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                    },
                    "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    }
                }
            },
            "maxItems": 8
        },
        "name": {
            "anyOf": [
                {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                },
                {
                    "type": "null"
                }
            ]
        },
        "street": {
            "anyOf": [
                {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                },
                {
                    "type": "null"
                }
            ]
        },
        "accessible_capacity": {
            "anyOf": [
                {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                },
                {
                    "type": "null"
                }
            ]
        },
        "access_category": {
            "enum": ["designated_accessible", "personal", "unknown"]
        },
        "orientation": {
            "enum": [null, "parallel", "perpendicular", "angled", "unknown"]
        },
        "restrictions": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
            },
            "maxItems": 32
        },
        "unmapped_fields": {
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
            },
            "maxItems": 32
        },
        "source_record_url": {
            "anyOf": [
                {
                    "type": "string",
                    "maxLength": 2048,
                    "pattern": "^https://[^/@]+/"
                },
                {
                    "type": "null"
                }
            ]
        }
    }
}
