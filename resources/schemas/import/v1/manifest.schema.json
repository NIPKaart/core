{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://nipkaart.nl/schemas/import/1.0/manifest.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "contract_version",
        "source_id",
        "batch_id",
        "source_sequence",
        "source_config_version",
        "scope_version",
        "mode",
        "record_kind",
        "adapter",
        "packages",
        "fetched_started_at",
        "fetched_finished_at",
        "source_updated_at",
        "source_version",
        "completeness",
        "artifact"
    ],
    "properties": {
        "contract_version": {
            "const": "1.0"
        },
        "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        },
        "batch_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
        },
        "source_sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
        },
        "source_config_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
        },
        "scope_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
        },
        "mode": {
            "const": "snapshot"
        },
        "record_kind": {
            "const": "municipal"
        },
        "adapter": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "version"],
            "properties": {
                "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                },
                "version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                }
            }
        },
        "packages": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "version"],
                "properties": {
                    "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                    },
                    "version": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                    }
                }
            },
            "maxItems": 16,
            "minItems": 1
        },
        "fetched_started_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$"
        },
        "fetched_finished_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$"
        },
        "source_updated_at": {
            "anyOf": [
                {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]Z$"
                },
                {
                    "type": "null"
                }
            ]
        },
        "source_version": {
            "anyOf": [
                {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                },
                {
                    "type": "null"
                }
            ]
        },
        "completeness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "pages_fetched",
                "pagination_exhausted",
                "expected_records",
                "records_seen",
                "records_filtered_out",
                "records_emitted",
                "records_failed"
            ],
            "properties": {
                "status": {
                    "const": "complete"
                },
                "pages_fetched": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                },
                "pagination_exhausted": {
                    "const": true
                },
                "expected_records": {
                    "anyOf": [
                        {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 10000
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "records_seen": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                },
                "records_filtered_out": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                },
                "records_emitted": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                },
                "records_failed": {
                    "const": 0
                }
            }
        },
        "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "version_id", "format", "bytes", "record_count", "sha256"],
            "properties": {
                "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                },
                "version_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "not": {
                        "const": "null"
                    }
                },
                "format": {
                    "const": "jsonl"
                },
                "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 33554432
                },
                "record_count": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            }
        }
    }
}
